---
import '../styles/global.css';
import { LOCALES, getTranslations, type Locale } from '../i18n/translations';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getTranslations(locale);

const siteUrl = 'https://habit-grid.github.io/';
const ogImagePngUrl = 'https://habit-grid.github.io/og-image.png';
const currentLocaleMeta = LOCALES.find((l) => l.code === locale) ?? LOCALES[0];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://habit-grid.github.io/#website',
      url: siteUrl,
      name: 'HabitGrid',
      alternateName: 'HabitGrid | 365-Day Zero-Server Habit Tracker',
      description: t.meta.description,
      inLanguage: ['en', 'es', 'pt', 'de', 'fr', 'ja', 'zh'],
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://habit-grid.github.io/#application',
      name: 'HabitGrid',
      headline: t.meta.title,
      description: t.meta.description,
      url: siteUrl,
      image: ogImagePngUrl,
      screenshot: ogImagePngUrl,
      applicationCategory: 'LifestyleApplication',
      applicationSubCategory: 'HabitTracker',
      operatingSystem: 'Any (Web Browser)',
      isAccessibleForFree: true,
      offers: {
        '@type': 'Offer',
        price: '0.00',
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
      },
      featureList: [
        'GitHub-Style 365-Day Contribution Heatmap Grid',
        '4-Level Custom Activity Intensity Palette (#FFEFC4, #97D7FF, #4D8DBA, #086288)',
        '100% Client-Side LocalStorage Persistence with Zero Server Uploads',
        'Multi-Habit Boards & Multi-Year Isolation for Current & Future Years (2026–2030)',
        'One-Click High-DPI HTML5 Canvas PNG Graph Export',
      ],
      author: {
        '@type': 'Person',
        name: 'Kishara Dilz',
        url: 'https://ko-fi.com/kishara',
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://habit-grid.github.io/#breadcrumb',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://habit-grid.github.io/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: t.nav.tagline,
          item: 'https://habit-grid.github.io/#main-content',
        },
      ],
    },
    {
      '@type': 'HowTo',
      '@id': 'https://habit-grid.github.io/#howto',
      name: t.seoSection.howItWorksTitle,
      description: t.meta.description,
      image: ogImagePngUrl,
      totalTime: 'PT1M',
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: t.seoSection.step1Title,
          text: t.seoSection.step1Desc,
          url: 'https://habit-grid.github.io/#heatmap-section',
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: t.seoSection.step2Title,
          text: t.seoSection.step2Desc,
          url: 'https://habit-grid.github.io/#heatmap-section',
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: t.seoSection.step3Title,
          text: t.seoSection.step3Desc,
          url: 'https://habit-grid.github.io/#how-it-works-heading',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://habit-grid.github.io/#faq',
      mainEntity: [
        {
          '@type': 'Question',
          name: t.seoSection.faq1Q,
          acceptedAnswer: {
            '@type': 'Answer',
            text: t.seoSection.faq1A,
          },
        },
        {
          '@type': 'Question',
          name: t.seoSection.faq2Q,
          acceptedAnswer: {
            '@type': 'Answer',
            text: t.seoSection.faq2A,
          },
        },
        {
          '@type': 'Question',
          name: t.seoSection.faq3Q,
          acceptedAnswer: {
            '@type': 'Answer',
            text: t.seoSection.faq3A,
          },
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-G9ZXTBVVYR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-G9ZXTBVVYR');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title id="seo-title">{t.meta.title}</title>
    <meta id="seo-description" name="description" content={t.meta.description} />
    <meta id="seo-keywords" name="keywords" content={t.meta.keywords} />
    <meta name="author" content="Kishara Dilz" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <link rel="canonical" href={siteUrl} />

    <!-- Alternate hreflang tags for all 7 supported languages on the single canonical page -->
    <link rel="alternate" hreflang="x-default" href={siteUrl} />
    {
      LOCALES.map((loc) => (
        <link
          rel="alternate"
          hreflang={loc.code}
          href={loc.code === 'en' ? siteUrl : `${siteUrl}?lang=${loc.code}`}
        />
      ))
    }

    <!-- OpenGraph / Social Meta (100% Complete with 1200x630 Raster PNG, Dimensions & Alt) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HabitGrid" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImagePngUrl} />
    <meta property="og:image:secure_url" content={ogImagePngUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="HabitGrid — 365-Day Zero-Server GitHub-Style Habit Tracker"
    />
    <meta property="og:locale" content={currentLocaleMeta.ogLocale} />
    {
      LOCALES.filter((l) => l.code !== locale).map((l) => (
        <meta property="og:locale:alternate" content={l.ogLocale} />
      ))
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImagePngUrl} />
    <meta
      name="twitter:image:alt"
      content="HabitGrid — 365-Day Zero-Server GitHub-Style Habit Tracker"
    />

    <!-- Icons & Web App Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FCFBF7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#041821" media="(prefers-color-scheme: dark)" />

    <!-- Non-Render-Blocking Google Fonts for 100% Core Web Vitals & LCP Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Structured Data JSON-LD (@graph: WebSite, SoftwareApplication, BreadcrumbList, HowTo, FAQPage) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Theme Initialization Script: Default is Light Theme (#FCFBF7) unless 'dark' is saved -->
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem('habitgrid-theme');
          if (saved === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Accessibility Skip Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2.5 focus:rounded-xl focus:bg-[#086288] focus:text-[#FFEFC4] focus:font-semibold focus:shadow-lg"
    >
      Skip to main content
    </a>
    <slot />
  </body>
</html>
